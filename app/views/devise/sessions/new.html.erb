<div class="auth-container">
  <div class="auth-card">
    <div class="auth-card__logo">📈</div>
    <h1 class="auth-card__title">Position Size Calculator</h1>
    <p class="auth-card__subtitle">ログイン</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "パスワード", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-group form-group--checkbox">
          <%= f.check_box :remember_me, class: "form-checkbox" %>
          <%= f.label :remember_me, "ログイン状態を保持", class: "form-label form-label--inline" %>
        </div>
      <% end %>

      <%= f.submit "ログイン", class: "btn btn--primary btn--full" %>
    <% end %>

    <div class="auth-card__links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
